# Replace with a random value of at least 24 characters. scripts/init-local.sh creates one.
ADMIN_TOKEN=replace-with-a-random-secret-at-least-24-characters
GALLERY_PORT=5173
BACKOFFICE_PORT=5174
API_PORT=8080
# Docker Hub account that owns the release images (GitHub variable DOCKERHUB_USERNAME).
DOCKERHUB_USERNAME=your-dockerhub-username
# Optional common fallback for manual Compose use. CI deploys pin only their target.
IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=
BACKOFFICE_IMAGE_TAG=
BACKEND_IMAGE_TAG=
# Keep the project name used by an existing release to reuse its SQLite volume.
DEPLOY_PROJECT_NAME=otakuict-data-gallery
