# Replace with a random value of at least 24 characters. scripts/init-local.sh creates one.
ADMIN_TOKEN=replace-with-a-random-secret-at-least-24-characters
GALLERY_PORT=5173
BACKOFFICE_PORT=5174
API_PORT=8080
# Optional: country header set/overwritten by a trusted geolocation proxy.
# For a Cloudflare-only origin, set CF-IPCountry and enable IP Geolocation.
# Leave empty when direct requests can reach the origin with spoofed headers.
GALLERY_COUNTRY_HEADER=
# Docker Hub account that owns the release images (GitHub variable DOCKERHUB_USERNAME).
DOCKERHUB_USERNAME=your-dockerhub-username
# Optional common fallback for manual Compose use. CI deploys pin only their target.
IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=
BACKOFFICE_IMAGE_TAG=
BACKEND_IMAGE_TAG=
# Keep the project name used by an existing release to reuse its SQLite volume.
DEPLOY_PROJECT_NAME=otakuict-data-gallery

# Finder API root (no /api suffix). Empty disables BO lookup.
# Native local backend: http://127.0.0.1:3001
# Docker backend to a finder published on the host:
GANK_FINDER_URL=http://host.docker.internal:3001
# Server-only TypeSafe credential. Never use a VITE_ variable for this key.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
